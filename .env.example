# =============================================================================
# Variables d'environnement — Chalet Yolo
# -----------------------------------------------------------------------------
# Copiez ce fichier en « .env » pour tester en local, ou renseignez ces
# variables dans Netlify : Site configuration > Environment variables.
# Si elles sont vides, AUCUN script de statistiques n'est chargé.
# =============================================================================

# Statistiques Umami (sans cookies, pas de bandeau nécessaire)
# URL du script fourni par Umami, ex. https://cloud.umami.is/script.js
PUBLIC_ANALYTICS_UMAMI_SRC=
# Identifiant du site dans Umami (Website ID), ex. 1a2b3c4d-....
PUBLIC_ANALYTICS_UMAMI_ID=

