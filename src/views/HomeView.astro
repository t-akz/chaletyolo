---
/**
 * Page d'accueil (FR et EN) — structure du §6 de CLAUDE.md (refonte du 06/11/2026) :
 * Hero en carrousel (4 photos, défilement automatique, 12/11/2026) → 5 cartes-photos (Le Chalet, Piscine & Spa
 * — ajoutée le 13/11/2026 —, Services, Méribel, Offre & Contact) → mosaïque de photos → appel à l'action.
 * Écran d'entrée (IntroGate, §5.8) par-dessus, une fois par session : option « intro » ci-dessous.
 * Textes : src/content/{fr,en}/home.json.
 */
import CTASection from '../components/CTASection.astro';
import HeroCarousel from '../components/HeroCarousel.astro';
import PhotoMosaic from '../components/PhotoMosaic.astro';
import ImageLinkCards from '../components/ImageLinkCards.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import type { Lang } from '../i18n/languages';
import { contactFormPath, getContent, localizedPath } from '../i18n/utils';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const common = getContent(lang, 'common');
const page = getContent(lang, 'home');

// Photos du carrousel du hero, dans l'ordre d'affichage (choix du client du 12/11/2026).
// « accueil » = photo du chalet retouchée (hero/le-chalet.jpg sans le tuyau gris).
const heroPhotos = ['accueil', 'piscine-04', 'cinema-01', 'service-01'];

// Section sous le hero : 5 cartes-photos cliquables vers les pages principales.
const cards = page.intro.cards;
const introCards = [
  { ...cards.chalet, photoId: 'sejour-01', href: localizedPath('chalet', lang) },
  { ...cards.poolSpa, photoId: 'piscine-02', href: localizedPath('poolSpa', lang) },
  { ...cards.services, photoId: 'cuisine-01', href: localizedPath('services', lang) },
  { ...cards.meribel, photoId: 'meribel-03', href: localizedPath('meribel', lang) },
  { ...cards.contact, photoId: 'exterieur-02', href: localizedPath('contact', lang) },
];

// Photos de la mosaïque (8 pour une grille complète), dans l'ordre d'affichage.
const mosaicPhotos = [
  'piscine-04',
  'sejour-01',
  'chambre-01',
  'bien-etre-01',
  'exterieur-01',
  'cinema-01',
  'cuisine-01',
  'yoga-02',
];
---

<BaseLayout lang={lang} routeKey="home" title={page.meta.title} description={page.meta.description} photoId="accueil" lodging hero intro>
  <HeroCarousel
    lang={lang}
    photoIds={heroPhotos}
    title={page.hero.title}
    subtitle={page.hero.subtitle}
    cta={{ href: contactFormPath(lang), label: common.cta.contact }}
    labels={page.hero.carousel}
  />

  <section class="bg-bg-alt py-16 md:py-28" aria-label={page.intro.label}>
    <div class="container-page">
      <ImageLinkCards lang={lang} items={introCards} />
    </div>
  </section>

  <PhotoMosaic
    lang={lang}
    photoIds={mosaicPhotos}
    title={page.gallery.title}
    link={{ href: localizedPath('gallery', lang), label: page.gallery.link }}
  />

  <CTASection lang={lang} title={page.cta.title} />
</BaseLayout>
