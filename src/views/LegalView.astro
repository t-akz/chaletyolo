---
/**
 * Pages légales (FR et EN) : « Mentions légales » et « Confidentialité ».
 * Gabarits : les informations manquantes sont marquées « [À FOURNIR] ».
 * Textes : src/content/{fr,en}/legal.json et privacy.json.
 * Ces textes sont des modèles à faire valider par un professionnel du droit.
 */
import TextLink from '../components/TextLink.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import type { Lang } from '../i18n/languages';
import { getContent, localizedPath } from '../i18n/utils';

interface Props {
  lang: Lang;
  page: 'legal' | 'privacy';
}

const { lang, page: pageKey } = Astro.props;
const page = getContent(lang, pageKey);
---

<BaseLayout lang={lang} routeKey={pageKey} title={page.meta.title} description={page.meta.description}>
  <article class="container-page max-w-3xl py-16 md:py-24">
    <h1>{page.title}</h1>
    <p class="mt-6 text-sm">{page.updated}</p>

    {
      page.sections.map((section) => (
        <section class="mt-12 border-t border-border pt-8">
          <h2 class="text-h3">{section.title}</h2>
          <div class="mt-4 space-y-3">
            {section.paragraphs.map((paragraph) => (
              <p>{paragraph}</p>
            ))}
          </div>
          {'link' in section && section.link && (
            <div class="mt-6">
              <TextLink href={localizedPath('privacy', lang)}>{section.link}</TextLink>
            </div>
          )}
        </section>
      ))
    }
  </article>
</BaseLayout>
