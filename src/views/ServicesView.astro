---
/**
 * Page « Services » (FR et EN) — refonte du 08/11/2026, 3 sections :
 * Hero → « Prestations & Facilities » (deux cadres listés) → appel à l'action.
 * Textes : src/content/{fr,en}/services.json. Les lignes des deux cadres sont
 * écrites telles quelles dans offer.services et offer.facilities (regroupées
 * le 09/11/2026) : ajouter, retirer ou réordonner une ligne se fait là.
 * Elles ne doivent contenir que des faits du §8 de CLAUDE.md.
 */
import CTASection from '../components/CTASection.astro';
import Hero from '../components/Hero.astro';
import ServiceTables from '../components/ServiceTables.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import type { Lang } from '../i18n/languages';
import { getContent } from '../i18n/utils';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const page = getContent(lang, 'services');
---

<BaseLayout lang={lang} routeKey="services" title={page.meta.title} description={page.meta.description} photoId="services" hero>
  <Hero lang={lang} photoId="services" title={page.hero.title} subtitle={page.hero.subtitle} height="large" />

  <ServiceTables
    title={page.offer.title}
    tables={[
      { title: page.offer.servicesTitle, items: page.offer.services },
      { title: page.offer.facilitiesTitle, items: page.offer.facilities },
    ]}
  />

  <CTASection lang={lang} title={page.cta.title} text={page.cta.text} />
</BaseLayout>
