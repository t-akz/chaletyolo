---
/**
 * Page « Méribel » (FR et EN) — structure du §6 de CLAUDE.md :
 * Hero → la station (+ lien Google Maps vers le quartier de La Gittaz) → appel à l'action.
 * (Section « Localisation » retirée à la demande du client le 02/11/2026.)
 * (Section « Accès » retirée à la demande du client le 02/11/2026.)
 * (Section « Activités d'hiver » retirée à la demande du client le 09/11/2026.)
 * Textes : src/content/{fr,en}/meribel.json ; faits : src/content/chalet.ts.
 */
import CTASection from '../components/CTASection.astro';
import FeatureSection from '../components/FeatureSection.astro';
import Hero from '../components/Hero.astro';
import { laGittazMapsUrl, meribel } from '../content/chalet';
import BaseLayout from '../layouts/BaseLayout.astro';
import type { Lang } from '../i18n/languages';
import { format, getContent } from '../i18n/utils';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const page = getContent(lang, 'meribel');
const common = getContent(lang, 'common');

// Lien Google Maps vers le QUARTIER de La Gittaz : src/content/chalet.ts (CLAUDE.md §5.7).
// Phrase « … quartier {link}. » coupée autour du lien.
const [locationBefore, locationAfter = ''] = page.resort.location.split('{link}');
---

<BaseLayout lang={lang} routeKey="meribel" title={page.meta.title} description={page.meta.description} photoId="meribel" hero>
  <Hero lang={lang} photoId="meribel" title={page.hero.title} subtitle={page.hero.subtitle} height="large" />

  <FeatureSection
    lang={lang}
    photoId="meribel-03"
    eyebrow={page.resort.eyebrow}
    title={page.resort.title}
    text={format(page.resort.text, { foundedYear: meribel.foundedYear, skiAreaKm: meribel.skiAreaKm })}
  >
    <p class="mt-4 max-w-md">
      {locationBefore}<a href={laGittazMapsUrl} target="_blank" rel="noopener" class="text-accent underline underline-offset-4">{page.resort.locationLink}<span class="sr-only"> {common.newTab}</span></a>{locationAfter}
    </p>
  </FeatureSection>

  <CTASection lang={lang} title={page.cta.title} />
</BaseLayout>
