---
/**
 * « Meet the team » (page Services, entre « Prestations & Facilities » et
 * « Parlons de votre séjour ») : présentation de l'équipe du chalet.
 *
 * - Titre en haut, aligné à gauche ; pas d'introduction (retirée à la demande du
 *   client le 13/11/2026).
 * - Cartes en dessous, centrées dans la page (largeur limitée à ~900 px) : côte à
 *   côte dès 640 px, l'une sous l'autre sur mobile.
 * - Chaque carte : portrait (format 4:5, coins arrondis), prénom (titre bordeaux),
 *   rôle (sur-titre), une ou deux lignes de présentation.
 * - Portrait absent : aplat neutre avec libellé (Photo.astro).
 *
 * Utilisé par : src/views/ServicesView.astro.
 * Textes : src/content/{fr,en}/services.json → team ; portraits : src/content/photos.ts (dossier « equipe »).
 */
import Photo from './Photo.astro';
import type { Lang } from '../i18n/languages';

interface Props {
  lang: Lang;
  title: string;
  members: { photoId: string; name: string; role: string; text: string }[];
}

const { lang, title, members } = Astro.props;
---

<section class="bg-bg pb-16 md:pb-28">
  <div class="container-page">
    <h2 class="text-h2" data-reveal>{title}</h2>

    <ul class="mx-auto mt-10 grid max-w-4xl gap-12 sm:grid-cols-2 sm:gap-6 md:mt-16 md:gap-10">
      {
        members.map((member) => (
          <li data-reveal>
            <div class="aspect-[4/5] overflow-hidden rounded-2xl">
              <Photo id={member.photoId} lang={lang} sizes="(min-width: 1024px) 440px, (min-width: 640px) 50vw, 100vw" />
            </div>
            <p class="eyebrow mt-6">{member.role}</p>
            <h3 class="mt-2">{member.name}</h3>
            <p class="mt-3 max-w-sm">{member.text}</p>
          </li>
        ))
      }
    </ul>
  </div>
</section>
