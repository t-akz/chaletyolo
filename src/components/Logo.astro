---
/**
 * Logo « Chalet Yolo / MERIBEL » (ourson + nom), dessiné en vectoriel.
 * Fichier : src/assets/logo/logo-yolo.svg (original fourni : images/logo_yolo.svg).
 *
 * Le logo n'a pas de couleur propre : il prend la couleur du texte autour
 * (« currentColor »). On choisit donc sa couleur avec une classe de texte :
 * - en-tête transparent sur photo → blanc (variante claire) ;
 * - fond clair → classe « text-logo » = rouge d'origine #b9121b (token --color-logo) ;
 * - thème B → --color-logo vaut blanc : version claire partout.
 *
 * La hauteur se règle avec une classe (ex. « h-15 ») ; la largeur suit.
 * Le nom « Chalet Yolo » reste lisible par les lecteurs d'écran (texte masqué).
 */
import LogoSvg from '../assets/logo/logo-yolo.svg';
import { identity } from '../content/chalet';

interface Props {
  class?: string;
}

const { class: className } = Astro.props;
---

<span class:list={['inline-block align-middle', className]}>
  <LogoSvg aria-hidden="true" focusable="false" class="h-full w-auto" />
  <span class="sr-only">{identity.name} · {identity.resort}</span>
</span>
