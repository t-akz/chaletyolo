---
/**
 * THÈME C — bascule de thème (proposition alternative).            [THEME-C]
 *
 * - « ?theme=c » dans l'adresse → thème « Alpin contemporain », mémorisé pour
 *   l'onglet (sessionStorage : ce n'est pas un cookie, rien n'est envoyé au serveur).
 * - « ?theme=a » → retour au thème par défaut.
 * - Toute autre valeur mémorisée (ex. d'un ancien thème retiré) est ignorée
 *   et effacée : le site reste alors en thème A.
 *
 * Le script est placé dans <head> et s'exécute avant l'affichage de la page :
 * il n'y a donc pas de « flash » de l'ancien thème.
 * Pour supprimer le thème C : supprimez ce fichier et sa ligne dans
 * src/layouts/BaseLayout.astro (procédure complète dans le README).
 */
---

<script is:inline>
  (function () {
    var key = 'chalet-yolo-theme';
    try {
      var param = new URLSearchParams(window.location.search).get('theme');
      if (param === 'c') sessionStorage.setItem(key, 'c');
      if (param === 'a') sessionStorage.removeItem(key);
      var stored = sessionStorage.getItem(key);
      if (stored === 'c') {
        document.documentElement.setAttribute('data-theme', 'c');
      } else if (stored !== null) {
        // Valeur inconnue ou périmée : on la nettoie.
        sessionStorage.removeItem(key);
      }
    } catch (e) {
      // sessionStorage indisponible (navigation privée stricte) : thème A.
    }
  })();
</script>
