---
/**
 * Icône Lucide décorative (masquée aux lecteurs d'écran).
 * Usage : <Icon name="van" />. La liste des noms est dans icons.ts.
 */
import { icons, type IconName } from './icons';

interface Props {
  name: IconName;
  size?: number;
  class?: string;
}

const { name, size = 24, class: className } = Astro.props;
const Component = icons[name];
---

<Component size={size} stroke-width={1.25} class={className} aria-hidden="true" focusable="false" />
