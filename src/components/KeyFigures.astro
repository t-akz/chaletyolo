---
/**
 * Chiffres clés, ex. « 330 m² · 15 personnes · 6 chambres · 6 salles de bain ».
 * 2 colonnes sur mobile, 4 sur ordinateur.
 */
interface Props {
  items: { value: string | number; label: string }[];
  /** Fond de la section : principal (crème) ou alterné. */
  background?: 'bg' | 'alt';
  /** Sans marge du haut : prolonge la section précédente (ex. intro de la page Le chalet). */
  flush?: boolean;
}

const { items, background = 'bg', flush = false } = Astro.props;
---

<section class:list={[flush ? 'pb-16 md:pb-28' : 'py-16 md:py-24', background === 'alt' ? 'bg-bg-alt' : 'bg-bg']}>
  <dl class="container-page grid grid-cols-2 gap-x-6 gap-y-10 md:grid-cols-4" data-reveal>
    {
      items.map((item) => (
        <div class="flex flex-col-reverse gap-2 border-l border-border pl-5">
          <dt class="text-sm">{item.label}</dt>
          <dd class="text-h2 leading-none font-bold text-heading">{item.value}</dd>
        </div>
      ))
    }
  </dl>
</section>
