---
/**
 * Accordéon des mois (onglet « Offre » de la page Offre & Contact).
 * Un volet par mois ; dans chaque volet, une carte par semaine (samedi → samedi) :
 * date d'arrivée et, en dessous, date de départ, prix total, et en petit le prix par nuit (total ÷ 7).
 *
 * - Ordinateur (≥ 1024 px) : volets côte à côte, nom du mois écrit à la verticale.
 *   Celui que l'on survole (souris) ou que l'on choisit (clic, clavier) s'élargit
 *   et montre ses cartes. Un volet est toujours ouvert : le mois en cours
 *   (s'il fait partie de la saison), sinon le premier.
 * - Mobile et tablette : bandes empilées qui s'ouvrent vers le bas ; un second
 *   clic referme. Une seule ouverte à la fois.
 * - Sans JavaScript : tout est affiché, l'un sous l'autre.
 * Même fonctionnement que SpaceColumns.astro (page Le chalet), sans photos.
 *
 * Lien « Réserver » en bas de chaque carte : ouvre l'onglet Contact avec les dates
 * déjà remplies dans le formulaire. Sans JavaScript : lien vers
 * « /contact/?arrivee=…&depart=…#demande ». Les semaines déjà commencées n'ont pas
 * de lien (masqué au chargement : le formulaire refuse une date passée).
 *
 * Semaine réservée : carte grisée, mention « Réservée », sans prix ni lien « Réserver ».
 * Mention spéciale (promo, exclu web…) : petite étiquette au-dessus des dates
 * (pas sur une semaine réservée).
 *
 * Données : src/content/tarifs.ts (gérées depuis l'admin). Textes : src/content/{fr,en}/contact.json.
 */
import BearHead from '../assets/logo/ourson.svg';
import Icon from './Icon.astro';
import TextLink from './TextLink.astro';
import { TO_PROVIDE } from '../config/site';
import { currency, nightsPerWeek, weekEnd, type Month } from '../content/tarifs';
import type { Lang } from '../i18n/languages';

interface Props {
  lang: Lang;
  /** Mois de la saison, chacun avec ses semaines (src/content/tarifs.ts). */
  months: Month[];
  /** Nom de la liste des mois, lu par les lecteurs d'écran. */
  label: string;
  /** Mention sous le prix total, ex. « {price} / nuit ». */
  perNight: string;
  /** Libellé du lien de réservation, ex. « Réserver ». */
  bookLabel: string;
  /** Mention d'une semaine réservée, ex. « Réservée ». */
  bookedLabel: string;
  /** Adresse de la page qui contient le formulaire, ex. « /contact/ ». */
  bookPath: string;
}

const { lang, months: season, label, perNight, bookLabel, bookedLabel, bookPath } = Astro.props;
const locale = lang === 'fr' ? 'fr-FR' : 'en-GB';

// Dates lues en temps universel : pas de décalage d'un jour selon le fuseau horaire.
const toDate = (iso: string) => new Date(`${iso}T00:00:00Z`);

const dayFormat = new Intl.DateTimeFormat(locale, { weekday: 'short', day: 'numeric', month: 'short', timeZone: 'UTC' });
const monthFormat = new Intl.DateTimeFormat(locale, { month: 'long', year: 'numeric', timeZone: 'UTC' });
const priceFormat = new Intl.NumberFormat(locale, { style: 'currency', currency, maximumFractionDigits: 0 });
// « sam. 7 nov. » → « Sam. 7 nov. » (majuscule en début de date).
const capitalize = (text: string) => text.charAt(0).toUpperCase() + text.slice(1);

// Mois prêts à afficher : titre (« Novembre 2026 ») et dates des semaines mises en forme.
const months = season.map(({ month, weeks }) => ({
  key: month,
  title: capitalize(monthFormat.format(toDate(`${month}-01`))),
  weeks: weeks.map((week) => {
    const end = weekEnd(week.start);
    return {
      ...week,
      end,
      startLabel: capitalize(dayFormat.format(toDate(week.start))),
      endLabel: capitalize(dayFormat.format(toDate(end))),
    };
  }),
}));

// Identifiant unique, au cas où le composant serait utilisé deux fois sur une page.
const uid = `mois-${Math.random().toString(36).slice(2, 8)}`;
---

<div class="week-acc" data-week-accordion style={`--months: ${months.length}`}>
  <ul class="week-acc__list" aria-label={label}>
    {
      months.map((month, index) => (
        <li class="week-col" data-month={month.key} data-open={index === 0 ? 'true' : 'false'}>
          <h3 class="week-col__heading">
            <button
              type="button"
              class="week-col__button"
              id={`${uid}-titre-${index}`}
              aria-expanded={index === 0 ? 'true' : 'false'}
              aria-controls={`${uid}-panneau-${index}`}
            >
              <span class="week-col__title">{month.title}</span>
              <Icon name="chevron-down" size={22} class="week-col__chevron" />
            </button>
          </h3>
          <div class="week-col__body" id={`${uid}-panneau-${index}`} role="region" aria-labelledby={`${uid}-titre-${index}`}>
            <div class="week-col__inner">
              <ul class="week-col__cards">
                {month.weeks.map((week) => (
                  <li class="week-card" data-booked={week.booked ? 'true' : undefined}>
                    {/* Tête d'ourson du logo, décorative, dans le coin haut droit. */}
                    <BearHead aria-hidden="true" focusable="false" class="week-card__bear" />
                    {/* Mention spéciale (promo, exclu web…), sauf sur une semaine réservée. */}
                    {week.badge && !week.booked && <p class="week-card__badge">{week.badge[lang]}</p>}
                    <p class="week-card__dates">
                      {/* Toujours sur deux lignes : arrivée, puis départ en dessous. */}
                      <time datetime={week.start}>{week.startLabel}</time>
                      <span class="sr-only"> – </span>
                      <time datetime={week.end}>{week.endLabel}</time>
                    </p>
                    {week.booked ? (
                      <p class="week-card__status">{bookedLabel}</p>
                    ) : (
                      <>
                        {week.price === null ? (
                          <p class="week-card__price">{TO_PROVIDE}</p>
                        ) : (
                          <>
                            <p class="week-card__price">{priceFormat.format(week.price)}</p>
                            <p class="week-card__night">
                              {perNight.replace('{price}', priceFormat.format(Math.round(week.price / nightsPerWeek)))}
                            </p>
                          </>
                        )}
                        <p class="week-card__book" data-book data-arrivee={week.start} data-depart={week.end}>
                          <TextLink href={`${bookPath}?arrivee=${week.start}&depart=${week.end}#demande`}>
                            {bookLabel}
                            <span class="sr-only">
                              {' '}
                              {week.startLabel} – {week.endLabel}
                            </span>
                          </TextLink>
                        </p>
                      </>
                    )}
                  </li>
                ))}
              </ul>
            </div>
          </div>
        </li>
      ))
    }
  </ul>
</div>

<style>
  /* ---------- Mobile et tablette (et sans JavaScript) : bandes empilées ---------- */
  .week-acc__list {
    border-top: 1px solid var(--color-border);
  }

  .week-col {
    border-bottom: 1px solid var(--color-border);
  }

  .week-col__button {
    display: flex;
    width: 100%;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    padding: 1.25rem 0;
    text-align: left;
    color: var(--color-heading);
    font-size: var(--text-h3);
    font-weight: 700;
    line-height: 1.2;
    cursor: pointer;
  }

  /* La flèche n'apparaît qu'avec JavaScript (sans lui, tout est déjà ouvert). */
  .week-col :global(.week-col__chevron) {
    display: none;
    flex-shrink: 0;
    transition: transform 0.4s ease;
  }

  :global(.js) .week-col :global(.week-col__chevron) {
    display: block;
  }

  .week-col__cards {
    display: grid;
    gap: 0.75rem;
    padding: 0.25rem 0 2rem;
  }

  @media (min-width: 640px) {
    .week-col__cards {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  /* Carte d'une semaine : dates, prix total, prix par nuit en petit. */
  .week-card {
    position: relative;
    display: flex;
    flex-direction: column;
    border: 1px solid var(--color-border);
    border-radius: 1rem;
    background: var(--color-bg-alt);
    padding: 1.25rem 1.5rem;
  }

  .week-card :global(.week-card__bear) {
    position: absolute;
    top: 1rem;
    right: 1rem;
    width: auto;
    height: 1rem;
    color: var(--color-primary);
  }

  /* Les dates ne passent pas sous l'ourson. */
  .week-card__dates {
    padding-right: 1.75rem;
    display: flex;
    flex-direction: column;
    font-weight: 500;
  }

  .week-card__price {
    margin-top: 0.75rem;
    color: var(--color-heading);
    font-size: 1.5rem;
    font-weight: 700;
    line-height: 1.2;
  }

  .week-card__night {
    margin-top: 0.25rem;
    font-size: 0.875rem;
  }

  /* Mention spéciale : petite étiquette bordeaux au-dessus des dates. */
  .week-card__badge {
    align-self: flex-start;
    margin-bottom: 0.75rem;
    margin-right: 1.75rem; /* ne passe pas sous l'ourson */
    border: 1px solid var(--color-primary);
    border-radius: 999px;
    padding: 0.125rem 0.625rem;
    color: var(--color-primary);
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  /* Semaine réservée : carte grisée (fond plus terne, dates et ourson atténués). */
  .week-card[data-booked] {
    background: color-mix(in srgb, var(--color-text) 6%, var(--color-bg));
  }

  .week-card[data-booked] .week-card__dates {
    opacity: 0.55;
  }

  .week-card[data-booked] :global(.week-card__bear) {
    color: var(--color-text);
    opacity: 0.3;
  }

  /* « Réservée » : reste parfaitement lisible (contraste plein). */
  .week-card__status {
    margin-top: 0.75rem;
    font-size: 0.875rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  /* Lien « Réserver » toujours en bas de la carte (cartes de même hauteur alignées). */
  .week-card__book {
    margin-top: auto;
    padding-top: 1.25rem;
  }

  /* Avec JavaScript : seules les bandes ouvertes montrent leurs cartes
     (ouverture en douceur grâce à la hauteur de grille 0 → 1). */
  :global(.js) .week-col__body {
    display: grid;
    grid-template-rows: 0fr;
    transition: grid-template-rows 0.6s cubic-bezier(0.2, 0.6, 0.2, 1);
  }

  :global(.js) .week-col__inner {
    min-height: 0;
    overflow: hidden;
  }

  :global(.js) .week-col[data-open='true'] .week-col__body {
    grid-template-rows: 1fr;
  }

  :global(.js) .week-col[data-open='true'] :global(.week-col__chevron) {
    transform: rotate(180deg);
  }

  /* ---------- Ordinateur (≥ 1024 px, avec JavaScript) : volets côte à côte ---------- */
  @media (min-width: 1024px) {
    /* « container-type » : les cartes peuvent se caler sur la largeur de toute la liste (unité cqw). */
    :global(.js) .week-acc__list {
      --gap: 0.75rem;
      --grow: 7; /* un volet ouvert est 7 fois plus large qu'un volet fermé */
      container-type: inline-size;
      display: flex;
      gap: var(--gap);
      min-height: 32rem;
      border-top: 0;
    }

    :global(.js) .week-col {
      position: relative;
      display: flex;
      flex: 1 1 0;
      min-width: 0;
      flex-direction: column;
      overflow: hidden;
      border: 1px solid var(--color-border);
      border-radius: 1rem;
      background: var(--color-bg-alt);
      transition: flex-grow 0.8s cubic-bezier(0.2, 0.6, 0.2, 1);
    }

    :global(.js) .week-col[data-open='true'] {
      flex-grow: var(--grow);
    }

    :global(.js) .week-col__button {
      padding: 1.75rem 1.75rem 1.25rem;
      white-space: nowrap;
    }

    :global(.js) .week-col :global(.week-col__chevron) {
      display: none;
    }

    /* Volet fermé : le bouton couvre tout le volet (un clic n'importe où l'ouvre)
       et le mois s'écrit à la verticale (se lit de bas en haut). */
    :global(.js) .week-col[data-open='false'] .week-col__heading {
      flex: 1;
    }

    :global(.js) .week-col[data-open='false'] .week-col__button {
      height: 100%;
      justify-content: center;
      padding: 1.75rem 0;
    }

    :global(.js) .week-col[data-open='false'] .week-col__button::before {
      content: '';
      position: absolute;
      inset: 0;
    }

    :global(.js) .week-col[data-open='false'] .week-col__title {
      writing-mode: vertical-rl;
      transform: rotate(180deg);
    }

    /* Volet ouvert : les cartes gardent une largeur fixe (pas de recomposition
       pendant l'élargissement) et apparaissent en fondu une fois le volet ouvert. */
    :global(.js) .week-col__body {
      transition: none;
    }

    :global(.js) .week-col[data-open='false'] .week-col__body {
      display: none;
    }

    /* Largeur = celle du volet une fois ouvert (calculée sur toute la liste) :
       2 colonnes de cartes vers 1024 px, 3 sur grand écran. */
    :global(.js) .week-col__cards {
      width: calc((100cqw - (var(--months) - 1) * var(--gap)) * var(--grow) / (var(--months) - 1 + var(--grow)) - 2px);
      grid-template-columns: repeat(auto-fill, minmax(13rem, 1fr));
      padding: 0 1.75rem 1.75rem;
    }

    :global(.js) .week-col[data-open='true'] .week-col__cards {
      animation: week-cards-in 0.6s ease 0.3s both;
    }

    /* Focus clavier visible sur tout le volet. */
    :global(.js) .week-col:has(.week-col__button:focus-visible) {
      outline: 2px solid var(--color-primary);
      outline-offset: 3px;
    }

    :global(.js) .week-col__button:focus-visible {
      outline: none;
    }
  }

  @keyframes week-cards-in {
    from {
      opacity: 0;
    }
  }
</style>

<script>
  // Ouverture des volets / bandes : une seule ouverte à la fois.
  const desktop = window.matchMedia('(min-width: 1024px)');
  const canHover = window.matchMedia('(hover: hover) and (pointer: fine)');

  document.querySelectorAll<HTMLElement>('[data-week-accordion]').forEach((root) => {
    const columns = [...root.querySelectorAll<HTMLElement>('.week-col')];

    const open = (target: HTMLElement | null) => {
      columns.forEach((column) => {
        const isOpen = column === target;
        column.dataset.open = String(isOpen);
        column.querySelector('.week-col__button')?.setAttribute('aria-expanded', String(isOpen));
      });
    };

    // Au chargement : le mois en cours s'il fait partie de la saison, sinon le premier.
    const now = new Date();
    const currentMonth = `${now.getFullYear()}-${String(now.getMonth() + 1).padStart(2, '0')}`;
    open(columns.find((column) => column.dataset.month === currentMonth) ?? columns[0] ?? null);

    columns.forEach((column) => {
      const button = column.querySelector<HTMLButtonElement>('.week-col__button');

      button?.addEventListener('click', () => {
        const isOpen = column.dataset.open === 'true';
        // Ordinateur : un volet reste toujours ouvert. Mobile : un second clic referme.
        if (isOpen && !desktop.matches) open(null);
        else if (!isOpen) open(column);
      });

      // Ordinateur avec souris : le survol suffit.
      column.addEventListener('mouseenter', () => {
        if (desktop.matches && canHover.matches && column.dataset.open !== 'true') open(column);
      });
    });

    // Lien « Réserver » : masqué pour les semaines déjà commencées (date passée refusée par le formulaire).
    const pad = (n: number) => String(n).padStart(2, '0');
    const today = `${now.getFullYear()}-${pad(now.getMonth() + 1)}-${pad(now.getDate())}`;
    root.querySelectorAll<HTMLElement>('[data-book]').forEach((book) => {
      if ((book.dataset.arrivee ?? '') < today) {
        book.hidden = true;
        return;
      }
      // Même page : ouvre l'onglet Contact (#demande) puis remplit les dates, sans recharger.
      book.querySelector('a')?.addEventListener('click', (event) => {
        event.preventDefault();
        const detail = { arrivee: book.dataset.arrivee, depart: book.dataset.depart };
        const prefill = () => document.dispatchEvent(new CustomEvent('contact-form:prefill', { detail }));
        if (location.hash === '#demande') prefill();
        else {
          // Les onglets (PageTabs) réagissent d'abord au changement d'adresse, puis on remplit.
          window.addEventListener('hashchange', prefill, { once: true });
          location.hash = 'demande';
        }
      });
    });

    // Passage mobile → ordinateur : en volets, il en faut toujours un ouvert.
    desktop.addEventListener('change', () => {
      if (desktop.matches && !columns.some((column) => column.dataset.open === 'true')) open(columns[0] ?? null);
    });
  });
</script>
