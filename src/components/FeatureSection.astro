---
/**
 * Section « photo + texte ». La photo passe à gauche ou à droite selon
 * « reverse », pour alterner d'une section à l'autre.
 * Texte court : 2–3 lignes maximum, aligné à gauche.
 */
import Eyebrow from './Eyebrow.astro';
import Photo from './Photo.astro';
import TextLink from './TextLink.astro';
import type { Lang } from '../i18n/languages';

interface Props {
  lang: Lang;
  photoId: string;
  eyebrow?: string;
  title: string;
  text?: string;
  link?: { href: string; label: string };
  /** Vrai : photo à droite, texte à gauche. */
  reverse?: boolean;
  background?: 'bg' | 'alt';
  /** Niveau du titre (h2 par défaut, h3 si la section est sous un autre titre h2). */
  headingLevel?: 2 | 3;
}

const {
  lang,
  photoId,
  eyebrow,
  title,
  text,
  link,
  reverse = false,
  background = 'bg',
  headingLevel = 2,
} = Astro.props;
const Heading = headingLevel === 2 ? 'h2' : 'h3';
---

<section class:list={['py-16 md:py-28', background === 'alt' ? 'bg-bg-alt' : 'bg-bg']}>
  <div class="container-page grid items-center gap-10 md:grid-cols-12 md:gap-16">
    <div
      class:list={[
        'aspect-[4/3] overflow-hidden md:col-span-7 md:aspect-[4/5] lg:aspect-[5/6]',
        reverse && 'md:order-2',
      ]}
      data-reveal
    >
      <Photo id={photoId} lang={lang} sizes="(min-width: 768px) 58vw, 100vw" />
    </div>

    <div class:list={['md:col-span-5', reverse && 'md:order-1']} data-reveal>
      {eyebrow && <Eyebrow class="mb-5">{eyebrow}</Eyebrow>}
      <Heading class="text-h2">{title}</Heading>
      {text && <p class="mt-6 max-w-md">{text}</p>}
      {
        link && (
          <div class="mt-8">
            <TextLink href={link.href}>{link.label}</TextLink>
          </div>
        )
      }
    </div>
  </div>
</section>
