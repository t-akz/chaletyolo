---
/**
 * Formulaire de demande de séjour en 2 étapes (Netlify Forms) — §7 de CLAUDE.md.
 *   Étape 1 « Le séjour » : dates, formule souhaitée, nombre de convives.
 *   Étape 2 « Le contact » : nom et prénom, rôle, canal de réponse,
 *   téléphone ou email selon le canal choisi, consentement.
 *
 * Netlify Forms :
 * - un seul formulaire « demande-sejour » pour le FR et l'EN (mêmes noms de champs) ;
 * - Netlify le détecte au déploiement grâce à data-netlify="true" ;
 * - champ caché « form-name » (obligatoire pour Netlify) et « langue » (fr / en) ;
 * - anti-spam : champ piège « bot-field » (invisible ; s'il est rempli, Netlify ignore l'envoi) ;
 * - après l'envoi : page /merci/ ou /en/thank-you/.
 * ATTENTION : l'envoi réel ne fonctionne pas en local, seulement sur Netlify.
 *
 * Sans JavaScript : les deux étapes s'affichent l'une sous l'autre, avec la
 * validation du navigateur. Avec JavaScript : une étape à la fois, messages
 * d'erreur dans la langue de la page sous chaque champ, départ après l'arrivée,
 * pas de date passée, et seul le champ utile (téléphone ou email) est affiché.
 */
import Button from './Button.astro';
import ChoiceGroup from './ChoiceGroup.astro';
import FormField from './FormField.astro';
import Icon from './Icon.astro';
import RequiredMark from './RequiredMark.astro';
import { figures } from '../content/chalet';
import type { Lang } from '../i18n/languages';
import { format, getContent, localizedPath } from '../i18n/utils';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const page = getContent(lang, 'contact');
const f = page.form;

// Nombre maximal de personnes (capacité du chalet, §8).
const maxGuests = figures.guests;

// Apparence commune des champs (uniquement des couleurs du design system).
const inputClass =
  'mt-2 block w-full border border-text/60 bg-bg-alt px-4 py-3 text-text transition-colors focus-visible:border-accent aria-[invalid=true]:border-error';
const checkboxClass = 'mt-0.5 size-5 shrink-0 accent-primary';
// Titre de chaque étape : reçoit le focus quand on change d'étape (tabindex -1).
const stepTitleClass = 'mt-3 scroll-mt-28 text-h3 focus:outline-none';
---

<form
  name="demande-sejour"
  method="POST"
  action={localizedPath('thanks', lang)}
  data-netlify="true"
  netlify-honeypot="bot-field"
  data-contact-form
  data-errors={JSON.stringify(page.errors)}
  class="grid gap-16"
>
  <!-- Champs techniques pour Netlify -->
  <input type="hidden" name="form-name" value="demande-sejour" />
  <input type="hidden" name="langue" value={lang} />
  <p class="hidden">
    <label>
      {f.honeypot}
      <input name="bot-field" tabindex="-1" autocomplete="off" />
    </label>
  </p>

  <!-- ========== Étape 1 : le séjour ========== -->
  <section data-step aria-labelledby="etape-sejour" class="grid gap-8 md:grid-cols-2 md:gap-x-6">
    <div class="md:col-span-2">
      <div class="flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1">
        <p class="eyebrow">{format(f.stepLabel, { current: 1, total: 2 })}</p>
        <!-- Explication discrète de l'astérisque -->
        <p class="text-xs"><RequiredMark /> {f.requiredNote}</p>
      </div>
      <h2 id="etape-sejour" tabindex="-1" data-step-title class={stepTitleClass}>{f.steps.stay}</h2>
    </div>

    <fieldset class="grid gap-6 md:col-span-2 md:grid-cols-2 md:gap-x-6">
      <legend class="mb-4 text-sm font-medium">{f.datesLegend}</legend>

      <FormField id="arrivee" label={f.arrival} required>
        <input
          id="arrivee"
          name="arrivee"
          type="date"
          required
          aria-describedby="arrivee-error"
          data-validate
          class={inputClass}
        />
      </FormField>

      <FormField id="depart" label={f.departure} required>
        <input
          id="depart"
          name="depart"
          type="date"
          required
          aria-describedby="depart-error"
          data-validate
          class={inputClass}
        />
      </FormField>

      <label class="flex items-start gap-3 md:col-span-2">
        <input type="checkbox" name="dates_flexibles" value="oui" class={checkboxClass} />
        <span>{f.flexible}</span>
      </label>
    </fieldset>

    <ChoiceGroup
      name="formule"
      legend={f.formulaLegend}
      options={f.formulas}
      required
      class="md:col-span-2"
    />

    <fieldset class="grid gap-6 md:col-span-2 md:grid-cols-2 md:gap-x-6">
      <legend class="mb-4 text-sm font-medium">{f.guestsLegend}</legend>

      <FormField id="adultes" label={f.adults}>
        <input
          id="adultes"
          name="adultes"
          type="number"
          min="1"
          max={maxGuests}
          step="1"
          inputmode="numeric"
          aria-describedby="adultes-error"
          data-validate
          class={inputClass}
        />
      </FormField>

      <FormField id="enfants" label={f.children}>
        <input
          id="enfants"
          name="enfants"
          type="number"
          min="0"
          max={maxGuests}
          step="1"
          inputmode="numeric"
          aria-describedby="enfants-error"
          data-validate
          class={inputClass}
        />
      </FormField>
    </fieldset>

    <!-- Bouton « Continuer » : uniquement avec JavaScript (sinon, l'étape 2 est déjà visible) -->
    <div class="md:col-span-2" data-js-only hidden>
      <Button data-next>{f.next}</Button>
    </div>
  </section>

  <!-- ========== Étape 2 : le contact ========== -->
  <section data-step aria-labelledby="etape-contact" class="grid gap-8 md:grid-cols-2 md:gap-x-6">
    <div class="md:col-span-2">
      <div class="flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1">
        <p class="eyebrow">{format(f.stepLabel, { current: 2, total: 2 })}</p>
        <!-- Explication discrète de l'astérisque -->
        <p class="text-xs"><RequiredMark /> {f.requiredNote}</p>
      </div>
      <h2 id="etape-contact" tabindex="-1" data-step-title class={stepTitleClass}>{f.steps.contact}</h2>
    </div>

    <FormField id="nom" label={f.name} required>
      <input
        id="nom"
        name="nom"
        type="text"
        required
        maxlength="120"
        autocomplete="name"
        aria-describedby="nom-error"
        data-validate
        class={inputClass}
      />
    </FormField>

    <ChoiceGroup
      name="role"
      legend={f.roleLegend}
      options={f.roles}
      checked="pour-moi-meme"
      variant="discreet"
      class="md:col-span-2"
    />

    <ChoiceGroup
      name="canal_reponse"
      legend={f.channelLegend}
      options={f.channels}
      required
      class="md:col-span-2"
    />

    <!-- Téléphone (WhatsApp ou appel) ou email : le script n'affiche que le champ utile -->
    <FormField id="telephone" label={f.phone} required hint={f.phoneHint} data-contact-field="phone">
      <input
        id="telephone"
        name="telephone"
        type="tel"
        maxlength="40"
        pattern="[+0-9 \(\)\.\-]{6,40}"
        autocomplete="tel"
        aria-describedby="telephone-hint telephone-error"
        data-validate
        class={inputClass}
      />
    </FormField>

    <FormField id="email" label={f.email} required data-contact-field="email">
      <input
        id="email"
        name="email"
        type="email"
        maxlength="200"
        autocomplete="email"
        aria-describedby="email-error"
        data-validate
        class={inputClass}
      />
    </FormField>

    <div class="md:col-span-2">
      <label class="flex items-start gap-3">
        <input
          id="consentement"
          type="checkbox"
          name="consentement"
          value="oui"
          required
          aria-describedby="consentement-error"
          data-validate
          class={checkboxClass}
        />
        <span>
          {f.consentBefore}
          <a href={localizedPath('privacy', lang)} class="text-accent underline underline-offset-4">{f.consentLink}</a>.
          <RequiredMark />
        </span>
      </label>
      <p id="consentement-error" class="mt-2 flex items-start gap-2 text-sm text-error" hidden>
        <Icon name="circle-alert" size={16} class="mt-0.5 shrink-0" />
        <span data-error-text></span>
      </p>
    </div>

    <div class="flex flex-wrap items-center gap-x-10 gap-y-6 md:col-span-2">
      <!-- Lien « Retour » : uniquement avec JavaScript -->
      <button
        type="button"
        data-back
        data-js-only
        hidden
        class="group inline-flex items-center gap-2 text-sm font-medium text-accent underline decoration-1 underline-offset-[6px] transition-[text-underline-offset] duration-300 hover:underline-offset-[9px]"
      >
        <Icon name="arrow-left" size={16} class="transition-transform duration-300 group-hover:-translate-x-1" />
        {f.back}
      </button>
      <Button type="submit">{f.submit}</Button>
    </div>
  </section>
</form>

<script>
  type Control = HTMLInputElement | HTMLTextAreaElement;

  const form = document.querySelector<HTMLFormElement>('[data-contact-form]');

  if (form) {
    const messages = JSON.parse(form.dataset.errors ?? '{}') as Record<string, string>;
    // Le script prend le relais du navigateur pour afficher les erreurs dans la bonne langue.
    form.noValidate = true;

    const arrival = form.querySelector<HTMLInputElement>('#arrivee')!;
    const departure = form.querySelector<HTMLInputElement>('#depart')!;
    const steps = Array.from(form.querySelectorAll<HTMLElement>('[data-step]'));
    const fields = Array.from(form.querySelectorAll<Control>('[data-validate]'));
    let currentStep = 0;
    let submitted = false;

    // --- Message d'erreur adapté à chaque cas ---
    const messageFor = (input: Control): string => {
      // Champ masqué (ex. email quand on a choisi WhatsApp) : jamais en erreur.
      if (input.disabled) return '';
      const v = input.validity;
      if (v.valueMissing) {
        if (input.type === 'checkbox') return messages.consent!;
        if (input.type === 'radio') return messages.choice!;
        return messages.required!;
      }
      if (v.typeMismatch) return messages.email!;
      if (v.patternMismatch) return messages.phone!;
      if (input.type === 'date') {
        if (v.badInput) return messages.date!;
        if (input === departure && arrival.value && input.value && input.value <= arrival.value) {
          return messages.departureAfter!;
        }
        if (v.rangeUnderflow) return messages.pastDate!;
      }
      if (input.type === 'number' && !v.valid) {
        return messages.number!.replace('{min}', (input as HTMLInputElement).min).replace('{max}', (input as HTMLInputElement).max);
      }
      return v.valid ? '' : messages.required!;
    };

    // Affiche (ou efface) l'erreur sous le champ. Renvoie vrai si le champ est valide.
    const validate = (input: Control): boolean => {
      const message = messageFor(input);
      const error = document.getElementById(`${input.id}-error`);
      if (message) input.setAttribute('aria-invalid', 'true');
      else input.removeAttribute('aria-invalid');
      if (error) {
        error.querySelector('[data-error-text]')!.textContent = message;
        error.hidden = !message;
      }
      return !message;
    };

    // Champ à vérifier pour un élément modifié (pour un groupe radio : son premier bouton).
    const fieldFor = (target: EventTarget | null): Control | undefined => {
      if (target instanceof HTMLInputElement && target.type === 'radio') {
        return fields.find((input) => input.name === target.name);
      }
      return fields.find((input) => input === target);
    };

    // Revalidation pendant la saisie, une fois qu'une erreur a été signalée.
    const recheck = (event: Event) => {
      const input = fieldFor(event.target);
      if (input && (submitted || input.hasAttribute('aria-invalid'))) validate(input);
    };
    form.addEventListener('input', recheck);
    form.addEventListener('change', recheck);

    // --- Dates : pas de date passée, départ au moins 1 jour après l'arrivée ---
    const pad = (n: number) => String(n).padStart(2, '0');
    const now = new Date();
    const today = `${now.getFullYear()}-${pad(now.getMonth() + 1)}-${pad(now.getDate())}`;
    const nextDay = (iso: string) => {
      const date = new Date(`${iso}T00:00:00Z`);
      date.setUTCDate(date.getUTCDate() + 1);
      return date.toISOString().slice(0, 10);
    };
    arrival.min = today;
    departure.min = nextDay(today);
    arrival.addEventListener('change', () => {
      departure.min = nextDay(arrival.value || today);
      if (submitted || departure.value) validate(departure);
    });

    // --- Canal de réponse : WhatsApp ou appel → téléphone ; Email → email ---
    const contactFields = Array.from(form.querySelectorAll<HTMLElement>('[data-contact-field]'));
    const updateContactField = () => {
      const channel = form.querySelector<HTMLInputElement>('input[name="canal_reponse"]:checked')?.value;
      const wanted = channel ? (channel === 'email' ? 'email' : 'phone') : null;
      contactFields.forEach((wrapper) => {
        const input = wrapper.querySelector('input')!;
        const active = wrapper.dataset.contactField === wanted;
        wrapper.hidden = !active;
        // Champ masqué : désactivé (ni vérifié, ni envoyé).
        input.disabled = !active;
        input.required = active;
        if (!active) validate(input);
      });
    };
    form.querySelectorAll('input[name="canal_reponse"]').forEach((radio) => radio.addEventListener('change', updateContactField));
    updateContactField();

    // --- Étapes : une seule visible à la fois ---
    const showStep = (index: number, moveFocus = true) => {
      steps.forEach((step, i) => (step.hidden = i !== index));
      currentStep = index;
      if (moveFocus) steps[index]!.querySelector<HTMLElement>('[data-step-title]')!.focus();
    };

    // Vérifie les champs d'une étape ; renvoie ceux qui sont en erreur.
    const invalidFieldsIn = (step: HTMLElement) => fields.filter((input) => step.contains(input) && !validate(input));

    const goToNextStep = () => {
      const invalid = invalidFieldsIn(steps[0]!);
      if (invalid.length > 0) invalid[0]!.focus();
      else showStep(1);
    };

    form.querySelectorAll<HTMLElement>('[data-js-only]').forEach((element) => (element.hidden = false));
    form.querySelector('[data-next]')!.addEventListener('click', goToNextStep);
    form.querySelector('[data-back]')!.addEventListener('click', () => showStep(0));
    showStep(0, false);

    form.addEventListener('submit', (event) => {
      // « Entrée » pendant l'étape 1 : on passe à l'étape 2 au lieu d'envoyer.
      if (currentStep === 0) {
        event.preventDefault();
        goToNextStep();
        return;
      }
      submitted = true;
      const invalid = fields.filter((input) => !validate(input));
      if (invalid.length > 0) {
        event.preventDefault();
        const first = invalid[0]!;
        const stepIndex = steps.findIndex((step) => step.contains(first));
        if (stepIndex !== currentStep) showStep(stepIndex, false);
        first.focus();
      }
    });
  }
</script>
