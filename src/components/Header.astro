---
/**
 * En-tête du site.
 * - Pages avec photo plein écran (« transparent ») : en-tête transparent,
 *   texte blanc, puis fond crème + légère ombre dès que l'on fait défiler
 *   (sur l'accueil : seulement quand la scène du hero animé remonte, voir HeroReveal.astro).
 * - Autres pages : fond crème dès le départ.
 * - Sur toutes les largeurs (choix du client du 08/11/2026) : logo à gauche ; à droite,
 *   le bouton « Nous contacter » puis, tout à droite, le bouton « Menu » (burger).
 *   Le menu est toujours replié dans ce menu plein écran, qui contient aussi le
 *   sélecteur FR | EN (en haut) ; fermeture : bouton, touche Échap ou clic sur un lien.
 */
import Button from './Button.astro';
import Icon from './Icon.astro';
import LanguageSwitcher from './LanguageSwitcher.astro';
import Logo from './Logo.astro';
import type { Lang } from '../i18n/languages';
import type { RouteKey } from '../i18n/routes';
import { getContent, localizedPath } from '../i18n/utils';

interface Props {
  lang: Lang;
  routeKey?: RouteKey;
  /** Vrai si la page commence par une photo plein écran (Hero). */
  transparent?: boolean;
}

const { lang, routeKey, transparent = false } = Astro.props;
const common = getContent(lang, 'common');

// Entrées du menu, dans l'ordre d'affichage.
const menuKeys = ['chalet', 'services', 'meribel', 'gallery', 'contact'] as const;
const menu = menuKeys.map((key) => ({
  key,
  label: common.nav[key],
  href: localizedPath(key, lang),
  current: key === routeKey,
}));
---

<header
  data-header
  data-transparent={transparent ? 'true' : 'false'}
  data-solid={transparent ? 'false' : 'true'}
  class="group fixed inset-x-0 top-0 z-40 text-white transition-[background-color,color,box-shadow] duration-500 data-[solid=true]:bg-bg data-[solid=true]:text-text data-[solid=true]:shadow-[0_1px_16px_rgb(0_0_0/0.07)]"
>
  <div class="container-page flex h-22 items-center justify-between gap-3">
    <a href={localizedPath('home', lang)} aria-label={common.header.homeLink}>
      <Logo class="h-12 sm:h-15 transition-colors duration-500 group-data-[solid=true]:text-logo" />
    </a>

    <!-- À droite : bouton « Nous contacter », puis bouton du menu (burger) tout à droite -->
    <div class="flex items-center gap-3 sm:gap-6">
      <Button href={localizedPath('contact', lang)} size="sm">{common.cta.contact}</Button>
      <button type="button" data-menu-open aria-controls="menu-mobile" aria-expanded="false" class="-mr-2 p-2">
        <Icon name="menu" size={28} />
        <span class="sr-only">{common.header.openMenu}</span>
      </button>
    </div>
  </div>

  <!-- Menu plein écran, toutes largeurs (élément <dialog> : gère Échap et le focus) -->
  <dialog
    id="menu-mobile"
    data-mobile-menu
    aria-label={common.nav.label}
    class="menu-dialog m-0 h-svh max-h-none w-full max-w-none bg-bg p-0 text-text open:flex open:flex-col"
  >
    <div class="container-page flex h-22 shrink-0 items-center justify-between">
      <a href={localizedPath('home', lang)} aria-label={common.header.homeLink}>
        <Logo class="h-12 text-logo sm:h-15" />
      </a>
      <!-- En haut à droite : sélecteur FR | EN, puis bouton de fermeture -->
      <div class="flex items-center gap-6">
        <LanguageSwitcher lang={lang} routeKey={routeKey} class="text-[0.8125rem]!" />
        <button type="button" data-menu-close class="-mr-2 p-2">
          <Icon name="x" size={28} />
          <span class="sr-only">{common.header.closeMenu}</span>
        </button>
      </div>
    </div>

    <nav aria-label={common.nav.label} class="container-page flex flex-1 flex-col justify-center">
      <ul class="flex flex-col gap-5">
        {
          menu.map((item) => (
            <li>
              <a
                href={item.href}
                data-menu-close
                aria-current={item.current ? 'page' : undefined}
                class="text-[clamp(2rem,8vw,3rem)] leading-tight font-light text-heading uppercase aria-[current=page]:underline aria-[current=page]:decoration-1 aria-[current=page]:underline-offset-8"
              >
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="container-page flex shrink-0 items-center py-8">
      <Button href={localizedPath('contact', lang)}>{common.cta.contact}</Button>
    </div>
  </dialog>
</header>

<script>
  // En-tête : passe en fond crème après un léger défilement (pages avec photo plein écran).
  // Si la page contient un bloc « data-header-transparent-until » (hero animé de
  // l'accueil), l'en-tête reste transparent tant que ce bloc occupe l'écran, et
  // devient crème dès que sa fin apparaît (la scène commence alors à remonter).
  const header = document.querySelector<HTMLElement>('[data-header]');
  if (header?.dataset.transparent === 'true') {
    const until = document.querySelector<HTMLElement>('[data-header-transparent-until]');
    const update = () => {
      const solid = until ? until.getBoundingClientRect().bottom <= window.innerHeight + 1 : window.scrollY > 40;
      header.dataset.solid = String(solid);
    };
    update();
    window.addEventListener('scroll', update, { passive: true });
    window.addEventListener('resize', update);
  }

  // Menu mobile : ouverture / fermeture.
  const dialog = document.querySelector<HTMLDialogElement>('[data-mobile-menu]');
  const openButton = document.querySelector<HTMLButtonElement>('[data-menu-open]');
  if (dialog && openButton) {
    openButton.addEventListener('click', () => {
      dialog.showModal();
      openButton.setAttribute('aria-expanded', 'true');
    });
    dialog.querySelectorAll('[data-menu-close]').forEach((element) => {
      element.addEventListener('click', () => dialog.close());
    });
    dialog.addEventListener('close', () => openButton.setAttribute('aria-expanded', 'false'));
  }
</script>
