---
/**
 * Gabarit commun à toutes les pages : <html lang>, <head> (SEO, favicon,
 * polices, styles, thème, statistiques), en-tête, pied de page et bouton WhatsApp.
 */
import '@fontsource/cormorant-garamond/400.css';
import '@fontsource/cormorant-garamond/500.css';
import '@fontsource-variable/manrope';
import '../styles/global.css';

import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import Seo from '../components/Seo.astro';
import ThemeScript from '../components/ThemeScript.astro';
import WhatsAppButton from '../components/WhatsAppButton.astro';
import { getAnalytics } from '../config/site';
import type { Lang } from '../i18n/languages';
import type { RouteKey } from '../i18n/routes';
import { getContent } from '../i18n/utils';

interface Props {
  lang: Lang;
  /** Identifiant de la page dans la table des routes (sert au sélecteur de langue et à hreflang). */
  routeKey?: RouteKey;
  title: string;
  description: string;
  /** Vrai si la page commence par une photo plein écran : l'en-tête est alors transparent. */
  hero?: boolean;
  /** Empêche l'indexation (pages de remerciement, 404…). */
  noindex?: boolean;
  /** Photo de l'aperçu de partage (identifiant de src/content/photos.ts). */
  photoId?: string;
  /** Ajoute les données structurées « LodgingBusiness » (page d'accueil). */
  lodging?: boolean;
}

const { lang, routeKey, title, description, hero = false, noindex = false, photoId, lodging } = Astro.props;
const common = getContent(lang, 'common');

// Statistiques Umami (sans cookies) : uniquement si les 2 variables du .env sont remplies.
const analytics = getAnalytics();
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <!-- Signale que JavaScript est actif (sert aux animations d'apparition) -->
    <script is:inline>
      document.documentElement.classList.add('js');
    </script>
    <ThemeScript />
    <Seo
      lang={lang}
      routeKey={routeKey}
      title={title}
      description={description}
      noindex={noindex}
      photoId={photoId}
      lodging={lodging}
    />
    <!-- Favicon : tête d’ourson du logo (public/favicon.svg) -->
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta name="generator" content={Astro.generator} />
    {analytics && <script is:inline defer src={analytics.src} data-website-id={analytics.websiteId}></script>}
  </head>
  <body class="flex min-h-svh flex-col bg-bg text-text">
    <a
      href="#contenu"
      class="sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4 focus:z-50 focus:bg-bg focus:px-4 focus:py-2 focus:text-text"
    >
      {common.skipLink}
    </a>
    <Header lang={lang} routeKey={routeKey} transparent={hero} />
    <main id="contenu" class:list={['flex-1', !hero && 'pt-22']}>
      <slot />
    </main>
    <Footer lang={lang} />
    <WhatsAppButton lang={lang} />
    <script>
      import '../scripts/reveal';
    </script>
  </body>
</html>
